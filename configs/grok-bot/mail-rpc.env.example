# Journal-host mail RPC. Copy to ~/.goal-flight/mail-rpc.env (mode 0600).
# Generate the token on that host: openssl rand -hex 32
# Do not commit a real token. Do not paste values into chat.
# Names and paths: docs/hosts/mail-rpc.md

# Single-controller mode. Leave this unset when the users file below is set.
GOALFLIGHT_MAIL_RPC_TOKEN=
GOALFLIGHT_MAIL_RPC_BIND=127.0.0.1:8787
GOALFLIGHT_CONTROLLER_LABEL=goalflight-grokbot
# GOALFLIGHT_PROJECT_ROOT=/absolute/path/on/journal/host
# Set to 1 only to listen on 0.0.0.0 or ::. Prefer a Tailscale address in BIND.
# GOALFLIGHT_MAIL_RPC_ALLOW_PUBLIC_BIND=

# Several controllers, one bind. When this is set, TOKEN and CONTROLLER_LABEL
# above are not used for identity. File mode 0600.
# Shape: configs/grok-bot/mail-rpc.users.json.example
# GOALFLIGHT_MAIL_RPC_USERS_FILE=/home/<you>/.goal-flight/mail-rpc.users.json

# Grok Bot secret-request names (set on the bot, not in this file):
# MAIL_RPC_URL=http://<journal-host>:8787
# MAIL_RPC_TOKEN=
