#!/usr/bin/env bash
# goal-flight pre-push guard.
#
# docs-private/ is the operator's private notes tree (reviews, briefs, handoffs,
# measurements). It is gitignored and untracked; this guard keeps it that way on
# every remote by refusing a push whose outgoing commits ADD, MODIFY, RENAME or
# COPY any path under docs-private/. Deleting such paths is allowed, so the
# commit that stops tracking the tree can itself be pushed.
#
# After its own check it runs the machine-local hook at .git/hooks/pre-push when
# one exists (core.hooksPath points here, so git would otherwise skip it).
#
# Deliberate, vetted override: GOALFLIGHT_ALLOW_DOCS_PRIVATE_PUSH=1 git push ...
set -u

ZERO=0000000000000000000000000000000000000000
remote_name="${1:-}"
remote_url="${2:-}"
input=$(cat)
block=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue            # remote branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
  else
    commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
  fi
  for c in $commits; do
    # One line per changed path: STATUS<TAB>path[<TAB>path]. -m reports each
    # parent of a merge, so a merge that brings docs-private back is caught too.
    hits=$(git diff-tree -m -r --no-commit-id --name-status -M -C "$c" 2>/dev/null \
      | awk -F'\t' '$1 !~ /^D/ { for (i = 2; i <= NF; i++) if ($i ~ /^docs-private\//) { print $1 "\t" $i; break } }' \
      | head -5)
    if [ -n "$hits" ]; then
      echo "pre-push BLOCKED: commit $(git rev-parse --short "$c") adds or changes docs-private/ paths:" >&2
      printf '%s\n' "$hits" | sed 's/^/    /' >&2
      block=1
    fi
  done
done <<< "$input"

if [ "$block" = 1 ] && [ "${GOALFLIGHT_ALLOW_DOCS_PRIVATE_PUSH:-0}" != 1 ]; then
  echo "" >&2
  echo "Refusing to push: docs-private/ stays off every remote." >&2
  echo "Integrate by cherry-pick or squash so the private notes are not carried along." >&2
  echo "If this push is intentional and vetted: GOALFLIGHT_ALLOW_DOCS_PRIVATE_PUSH=1 git push ..." >&2
  exit 1
fi

local_hook="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [ -x "$local_hook" ]; then
  printf '%s\n' "$input" | "$local_hook" "$remote_name" "$remote_url" || exit $?
fi
exit 0
